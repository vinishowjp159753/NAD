console.log('🚀 ESPEP Sistema de Demandas');
console.log('💡 Senha: 123456');
console.log('👤 Setores: nuset, rh, financeiro, tecnologia, administracao, admin');
console.log('📋 Os dados são salvos no Firebase Firestore');
</script>


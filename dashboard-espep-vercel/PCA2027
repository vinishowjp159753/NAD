<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ESPEP - Sistema de Demandas</title>
    
    <!-- Firebase apenas para o banco de dados -->
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-firestore-compat.js"></script>
    
    <!-- Bibliotecas -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <style>
        /* ===== CORES ESPEP ===== */
        :root {
            --espep-primary: #003366;
            --espep-secondary: #1a5276;
            --espep-accent: #f39c12;
            --espep-light: #ecf0f1;
            --espep-dark: #2c3e50;
            --espep-success: #27ae60;
            --espep-danger: #e74c3c;
            --espep-warning: #f1c40f;
            --espep-info: #3498db;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
        }

        /* ===== NAVBAR ===== */
        .navbar-espep {
            background: linear-gradient(90deg, var(--espep-primary) 0%, var(--espep-secondary) 100%);
            box-shadow: 0 4px 20px rgba(0, 51, 102, 0.3);
            padding: 1rem 0;
        }

        .navbar-espep .navbar-brand {
            color: white;
            font-weight: 700;
            font-size: 1.8rem;
            letter-spacing: 2px;
        }

        .navbar-espep .navbar-brand i {
            color: var(--espep-accent);
            margin-right: 10px;
        }

        .navbar-espep .nav-link {
            color: rgba(255, 255, 255, 0.9) !important;
            font-weight: 500;
            transition: all 0.3s;
            margin: 0 5px;
        }

        .navbar-espep .nav-link:hover {
            color: var(--espep-accent) !important;
            transform: translateY(-2px);
        }

        .navbar-espep .nav-link i {
            margin-right: 8px;
        }

        .user-badge {
            background: rgba(255, 255, 255, 0.2);
            padding: 8px 20px;
            border-radius: 50px;
            color: white;
            font-weight: 500;
            border: 2px solid rgba(255, 255, 255, 0.1);
        }

        .user-badge i {
            color: var(--espep-accent);
            margin-right: 8px;
        }

        /* ===== CARDS ===== */
        .card-espep {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            border: none;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
            overflow: hidden;
        }

        .card-espep:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 50px rgba(0, 51, 102, 0.15);
        }

        .card-espep .card-header {
            background: linear-gradient(135deg, var(--espep-primary), var(--espep-secondary));
            color: white;
            padding: 1.5rem 2rem;
            border: none;
            font-weight: 600;
        }

        .card-espep .card-header i {
            margin-right: 10px;
            color: var(--espep-accent);
        }

        .card-espep .card-body {
            padding: 2rem;
        }

        /* ===== BOTÕES ===== */
        .btn-espep {
            background: linear-gradient(135deg, var(--espep-primary), var(--espep-secondary));
            color: white;
            border: none;
            padding: 12px 30px;
            border-radius: 50px;
            font-weight: 600;
            transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(0, 51, 102, 0.2);
        }

        .btn-espep:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 51, 102, 0.3);
            color: white;
        }

        .btn-espep-accent {
            background: linear-gradient(135deg, var(--espep-accent), #e67e22);
            color: white;
            border: none;
            padding: 12px 30px;
            border-radius: 50px;
            font-weight: 600;
            transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(243, 156, 18, 0.3);
        }

        .btn-espep-accent:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(243, 156, 18, 0.4);
            color: white;
        }

        /* ===== FORMULÁRIO ===== */
        .form-espep {
            background: white;
            padding: 2rem;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
        }

        .form-espep .form-control,
        .form-espep .form-select {
            border-radius: 12px;
            border: 2px solid #e9ecef;
            padding: 12px 20px;
            transition: all 0.3s;
        }

        .form-espep .form-control:focus,
        .form-espep .form-select:focus {
            border-color: var(--espep-primary);
            box-shadow: 0 0 0 0.2rem rgba(0, 51, 102, 0.15);
        }

        .form-espep label {
            font-weight: 600;
            color: var(--espep-dark);
            margin-bottom: 8px;
        }

        .form-espep label i {
            color: var(--espep-accent);
            margin-right: 6px;
        }

        /* ===== TABELAS ===== */
        .table-espep {
            border-radius: 15px;
            overflow: hidden;
        }

        .table-espep thead {
            background: linear-gradient(135deg, var(--espep-primary), var(--espep-secondary));
            color: white;
        }

        .table-espep thead th {
            padding: 15px 20px;
            font-weight: 600;
            border: none;
        }

        .table-espep tbody td {
            padding: 15px 20px;
            vertical-align: middle;
        }

        .table-espep tbody tr {
            transition: all 0.3s;
        }

        .table-espep tbody tr:hover {
            background: rgba(0, 51, 102, 0.05);
            transform: scale(1.01);
        }

        /* ===== STATUS BADGES ===== */
        .badge-status {
            padding: 8px 16px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.85rem;
        }

        .badge-pendente {
            background: #ffeaa7;
            color: #d63031;
        }

        .badge-andamento {
            background: #74b9ff;
            color: #0984e3;
        }

        .badge-concluido {
            background: #55efc4;
            color: #00b894;
        }

        .badge-urgente {
            background: #ff7675;
            color: #d63031;
            animation: pulse 1.5s infinite;
        }

        @keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.6; }
            100% { opacity: 1; }
        }

        /* ===== LOGIN ===== */
        .login-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, var(--espep-primary) 0%, #1a5276 100%);
            position: relative;
            overflow: hidden;
        }

        .login-container::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(243, 156, 18, 0.1) 0%, transparent 70%);
            animation: rotate 20s linear infinite;
        }

        @keyframes rotate {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .login-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            border-radius: 30px;
            padding: 3rem;
            width: 100%;
            max-width: 450px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            position: relative;
            z-index: 1;
        }

        .login-card .logo {
            text-align: center;
            margin-bottom: 2rem;
        }

        .login-card .logo i {
            font-size: 4rem;
            color: var(--espep-accent);
            background: rgba(243, 156, 18, 0.1);
            padding: 20px;
            border-radius: 50%;
        }

        .login-card .logo h3 {
            color: var(--espep-primary);
            font-weight: 700;
            margin-top: 1rem;
        }

        .login-card .logo p {
            color: #7f8c8d;
            font-size: 0.9rem;
        }

        /* ===== ADMIN DASHBOARD ===== */
        .stat-card {
            background: white;
            border-radius: 15px;
            padding: 1.5rem;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            transition: all 0.3s;
            border-left: 4px solid var(--espep-accent);
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        .stat-card .stat-number {
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--espep-primary);
        }

        .stat-card .stat-label {
            color: #7f8c8d;
            font-weight: 500;
        }

        .stat-card .stat-icon {
            font-size: 2rem;
            color: var(--espep-accent);
            opacity: 0.3;
        }

        /* ===== LOADING ===== */
        .loading-spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255,255,255,.3);
            border-radius: 50%;
            border-top-color: #fff;
            animation: spin 1s ease-in-out infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* ===== TOAST ===== */
        .toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
        }

        /* ===== RESPONSIVO ===== */
        @media (max-width: 768px) {
            .navbar-espep .navbar-brand {
                font-size: 1.2rem;
            }
            
            .login-card {
                padding: 2rem;
                margin: 1rem;
            }
            
            .card-espep .card-body {
                padding: 1rem;
            }
            
            .stat-card .stat-number {
                font-size: 1.8rem;
            }
        }

        /* ===== ANIMAÇÕES ===== */
        .fade-in {
            animation: fadeIn 0.5s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

<!-- ============================================ -->
<!-- ====== TELA DE LOGIN ====== -->
<!-- ============================================ -->
<div id="loginPage" class="login-container">
    <div class="login-card fade-in">
        <div class="logo">
            <i class="fas fa-flask"></i>
            <h3>ESPEP</h3>
            <p>Sistema de Demandas</p>
        </div>
        
        <form id="loginForm">
            <div class="mb-3">
                <label class="form-label"><i class="fas fa-user"></i> Setor</label>
                <select class="form-select" id="loginSetor" required>
                    <option value="">Selecione seu setor...</option>
                    <option value="nuset">NUSET</option>
                    <option value="rh">RH</option>
                    <option value="financeiro">Financeiro</option>
                    <option value="tecnologia">Tecnologia</option>
                    <option value="administracao">Administração</option>
                    <option value="admin">Administrador</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label"><i class="fas fa-lock"></i> Senha</label>
                <input type="password" class="form-control" id="loginSenha" placeholder="Digite sua senha" required>
                <small class="text-muted">💡 Senha padrão: <strong>123456</strong></small>
            </div>
            <button type="submit" class="btn btn-espep w-100" id="btnLogin">
                <i class="fas fa-sign-in-alt"></i> Entrar
            </button>
        </form>
        
        <div class="text-center mt-3">
            <small class="text-muted">
                <i class="fas fa-shield-alt"></i> Sistema ESPEP
            </small>
        </div>
    </div>
</div>

<!-- ============================================ -->
<!-- ====== SISTEMA PRINCIPAL ====== -->
<!-- ============================================ -->
<div id="mainSystem" style="display: none;">

    <!-- NAVBAR -->
    <nav class="navbar navbar-espep navbar-expand-lg sticky-top">
        <div class="container">
            <a class="navbar-brand" href="#">
                <i class="fas fa-flask"></i> ESPEP
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link" href="#" id="navDemandas">
                            <i class="fas fa-tasks"></i> Demandas
                        </a>
                    </li>
                    <li class="nav-item" id="adminNavItem" style="display: none;">
                        <a class="nav-link" href="#" id="navAdmin">
                            <i class="fas fa-chart-line"></i> Admin
                        </a>
                    </li>
                    <li class="nav-item">
                        <span class="user-badge" id="userBadge">
                            <i class="fas fa-user-circle"></i> <span id="userNameDisplay">Setor</span>
                        </span>
                    </li>
                    <li class="nav-item">
                        <button class="btn btn-espep-accent ms-2" id="btnLogout" style="padding: 8px 20px; font-size: 0.9rem;">
                            <i class="fas fa-sign-out-alt"></i> Sair
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container py-4">

        <!-- ====== PÁGINA DE DEMANDAS ====== -->
        <div id="demandasPage">
            <!-- Card Adicionar Demanda -->
            <div class="card-espep mb-4 fade-in">
                <div class="card-header">
                    <i class="fas fa-plus-circle"></i> Nova Demanda
                </div>
                <div class="card-body">
                    <form id="demandaForm" class="form-espep">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label><i class="fas fa-tag"></i> Título</label>
                                <input type="text" class="form-control" id="demandaTitulo" placeholder="Ex: Manutenção do servidor" required>
                            </div>
                            <div class="col-md-6">
                                <label><i class="fas fa-list"></i> Categoria</label>
                                <select class="form-select" id="demandaCategoria" required>
                                    <option value="">Selecione...</option>
                                    <option value="servicos">Serviços</option>
                                    <option value="maquinas">Máquinas</option>
                                    <option value="software">Software</option>
                                    <option value="infraestrutura">Infraestrutura</option>
                                    <option value="pessoal">Pessoal</option>
                                    <option value="outros">Outros</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label><i class="fas fa-flag"></i> Prioridade</label>
                                <select class="form-select" id="demandaPrioridade">
                                    <option value="baixa">Baixa</option>
                                    <option value="media" selected>Média</option>
                                    <option value="alta">Alta</option>
                                    <option value="urgente">Urgente</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label><i class="fas fa-calendar"></i> Prazo</label>
                                <input type="date" class="form-control" id="demandaPrazo">
                            </div>
                            <div class="col-12">
                                <label><i class="fas fa-align-left"></i> Descrição</label>
                                <textarea class="form-control" id="demandaDescricao" rows="3" placeholder="Descreva sua demanda..." required></textarea>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-espep" id="btnSalvarDemanda">
                                    <i class="fas fa-save"></i> Salvar Demanda
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Tabela de Demandas -->
            <div class="card-espep fade-in">
                <div class="card-header">
                    <i class="fas fa-table"></i> Minhas Demandas
                    <div class="float-end">
                        <button class="btn btn-sm btn-light me-2" id="btnFiltrarCategoria">
                            <i class="fas fa-filter"></i> Filtrar
                        </button>
                        <button class="btn btn-sm btn-light" id="btnLimparFiltro">
                            <i class="fas fa-times"></i> Limpar
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-espep" id="tabelaDemandas">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Título</th>
                                    <th>Categoria</th>
                                    <th>Prioridade</th>
                                    <th>Status</th>
                                    <th>Prazo</th>
                                    <th>Data</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>
                            <tbody id="demandasBody">
                                <tr>
                                    <td colspan="8" class="text-center py-4">
                                        <div class="loading-spinner"></div>
                                        <p class="mt-2 text-muted">Carregando demandas...</p>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- ====== PÁGINA ADMIN ====== -->
        <div id="adminPage" style="display: none;">
            <!-- Stats -->
            <div class="row mb-4 fade-in">
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="stat-number" id="totalDemandas">0</div>
                                <div class="stat-label">Total Demandas</div>
                            </div>
                            <div class="stat-icon"><i class="fas fa-tasks"></i></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card" style="border-left-color: #3498db;">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="stat-number" id="totalPendentes">0</div>
                                <div class="stat-label">Pendentes</div>
                            </div>
                            <div class="stat-icon"><i class="fas fa-clock"></i></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card" style="border-left-color: #27ae60;">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="stat-number" id="totalConcluidas">0</div>
                                <div class="stat-label">Concluídas</div>
                            </div>
                            <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card" style="border-left-color: #e74c3c;">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="stat-number" id="totalUrgentes">0</div>
                                <div class="stat-label">Urgentes</div>
                            </div>
                            <div class="stat-icon"><i class="fas fa-exclamation-triangle"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tabela Admin -->
            <div class="card-espep fade-in">
                <div class="card-header">
                    <i class="fas fa-database"></i> Todas as Demandas
                    <div class="float-end">
                        <button class="btn btn-sm btn-light me-2" id="btnFiltrarSetorAdmin">
                            <i class="fas fa-filter"></i> Filtrar por Setor
                        </button>
                        <button class="btn btn-sm btn-success" id="btnExportarExcel">
                            <i class="fas fa-file-excel"></i> Exportar Excel
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-espep" id="tabelaAdmin">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Setor</th>
                                    <th>Título</th>
                                    <th>Categoria</th>
                                    <th>Prioridade</th>
                                    <th>Status</th>
                                    <th>Prazo</th>
                                    <th>Data</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>
                            <tbody id="adminBody">
                                <tr>
                                    <td colspan="9" class="text-center py-4">
                                        <div class="loading-spinner"></div>
                                        <p class="mt-2 text-muted">Carregando dados...</p>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- ============================================ -->
<!-- ====== MODAL EDITAR ====== -->
<!-- ============================================ -->
<div class="modal fade" id="modalEditar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background: var(--espep-primary); color: white;">
                <h5 class="modal-title"><i class="fas fa-edit"></i> Editar Demanda</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editarForm">
                    <input type="hidden" id="editId">
                    <div class="mb-3">
                        <label>Título</label>
                        <input type="text" class="form-control" id="editTitulo" required>
                    </div>
                    <div class="mb-3">
                        <label>Categoria</label>
                        <select class="form-select" id="editCategoria">
                            <option value="servicos">Serviços</option>
                            <option value="maquinas">Máquinas</option>
                            <option value="software">Software</option>
                            <option value="infraestrutura">Infraestrutura</option>
                            <option value="pessoal">Pessoal</option>
                            <option value="outros">Outros</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label>Prioridade</label>
                        <select class="form-select" id="editPrioridade">
                            <option value="baixa">Baixa</option>
                            <option value="media">Média</option>
                            <option value="alta">Alta</option>
                            <option value="urgente">Urgente</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label>Status</label>
                        <select class="form-select" id="editStatus">
                            <option value="pendente">Pendente</option>
                            <option value="andamento">Em Andamento</option>
                            <option value="concluido">Concluído</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label>Prazo</label>
                        <input type="date" class="form-control" id="editPrazo">
                    </div>
                    <div class="mb-3">
                        <label>Descrição</label>
                        <textarea class="form-control" id="editDescricao" rows="3"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-espep" id="btnSalvarEdicao">
                    <i class="fas fa-save"></i> Salvar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================ -->
<!-- ====== TOAST DE NOTIFICAÇÃO ====== -->
<!-- ============================================ -->
<div class="toast-container">
    <div id="toastNotificacao" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
            <strong class="me-auto"><i class="fas fa-bell"></i> Notificação</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body" id="toastMensagem">
            Mensagem de notificação
        </div>
    </div>
</div>

<script>
// =============================================
// CONFIGURAÇÃO DO FIREBASE (APENAS BANCO DE DADOS)
// =============================================
const firebaseConfig = {
    apiKey: "AIzaSyBXf5zPUu2gZZyscZg9GxAi_2Unt46X--M",
    authDomain: "pca2027-bc832.firebaseapp.com",
    projectId: "pca2027-bc832",
    storageBucket: "pca2027-bc832.firebasestorage.app",
    messagingSenderId: "557215593109",
    appId: "1:557215593109:web:8f930ca2b94877f9e4e19c",
    measurementId: "G-8SFRV28KFN"
};

// Inicializar Firebase
firebase.initializeApp(firebaseConfig);
const db = firebase.firestore();

// =============================================
// VARIÁVEIS GLOBAIS
// =============================================
let setorAtual = '';
let demandas = [];
let todasDemandas = [];
let filtroCategoria = '';
let filtroSetorAdmin = '';

// =============================================
// FUNÇÕES DE NOTIFICAÇÃO
// =============================================
function mostrarNotificacao(mensagem, tipo = 'success') {
    const toast = document.getElementById('toastNotificacao');
    const body = document.getElementById('toastMensagem');
    body.textContent = mensagem;
    
    const header = toast.querySelector('.toast-header');
    if (tipo === 'success') {
        header.style.background = '#27ae60';
    } else if (tipo === 'error') {
        header.style.background = '#e74c3c';
    } else {
        header.style.background = '#3498db';
    }
    header.style.color = 'white';
    
    const bsToast = new bootstrap.Toast(toast);
    bsToast.show();
}

// =============================================
// LOGIN - SUPER SIMPLES
// =============================================
document.getElementById('loginForm').addEventListener('submit', function(e) {
    e.preventDefault();
    
    const setor = document.getElementById('loginSetor').value;
    const senha = document.getElementById('loginSenha').value;
    
    // VALIDAÇÃO SIMPLES
    if (!setor) {
        mostrarNotificacao('Selecione um setor!', 'error');
        return;
    }
    
    if (senha !== '123456') {
        mostrarNotificacao('Senha incorreta! Use 123456', 'error');
        document.getElementById('loginSenha').value = '';
        document.getElementById('loginSenha').focus();
        return;
    }
    
    // LOGIN BEM SUCEDIDO
    setorAtual = setor;
    document.getElementById('loginPage').style.display = 'none';
    document.getElementById('mainSystem').style.display = 'block';
    document.getElementById('userNameDisplay').textContent = setor.toUpperCase();
    
    // Mostrar admin apenas para admin
    if (setor === 'admin') {
        document.getElementById('adminNavItem').style.display = 'block';
        document.getElementById('navAdmin').click();
    } else {
        document.getElementById('adminNavItem').style.display = 'none';
        document.getElementById('navDemandas').click();
    }
    
    mostrarNotificacao(`Bem-vindo, ${setor.toUpperCase()}! 🎉`, 'success');
});

// =============================================
// NAVEGAÇÃO
// =============================================
document.getElementById('navDemandas').addEventListener('click', function(e) {
    e.preventDefault();
    document.getElementById('demandasPage').style.display = 'block';
    document.getElementById('adminPage').style.display = 'none';
    carregarDemandas();
});

document.getElementById('navAdmin').addEventListener('click', function(e) {
    e.preventDefault();
    if (setorAtual !== 'admin') {
        mostrarNotificacao('Acesso restrito ao Administrador!', 'error');
        return;
    }
    document.getElementById('demandasPage').style.display = 'none';
    document.getElementById('adminPage').style.display = 'block';
    carregarAdmin();
});

document.getElementById('btnLogout').addEventListener('click', function() {
    if (confirm('Deseja realmente sair?')) {
        document.getElementById('loginPage').style.display = 'flex';
        document.getElementById('mainSystem').style.display = 'none';
        document.getElementById('loginSetor').value = '';
        document.getElementById('loginSenha').value = '';
        mostrarNotificacao('Você saiu do sistema.', 'info');
    }
});

// =============================================
// CARREGAR DEMANDAS DO SETOR
// =============================================
async function carregarDemandas() {
    try {
        const tbody = document.getElementById('demandasBody');
        tbody.innerHTML = `
            <tr>
                <td colspan="8" class="text-center py-4">
                    <div class="loading-spinner"></div>
                    <p class="mt-2 text-muted">Carregando demandas...</p>
                </td>
            </tr>
        `;
        
        const snapshot = await db.collection('demandas')
            .where('setor', '==', setorAtual)
            .orderBy('data', 'desc')
            .get();
        
        demandas = [];
        snapshot.forEach(doc => {
            demandas.push({ id: doc.id, ...doc.data() });
        });
        
        renderizarDemandas();
    } catch (error) {
        console.error('Erro:', error);
        // Dados de exemplo para teste
        demandas = [
            {
                id: '1',
                titulo: 'Manutenção do servidor',
                categoria: 'servicos',
                prioridade: 'alta',
                status: 'pendente',
                prazo: '2026-08-15',
                data: new Date().toISOString(),
                descricao: 'Servidor com problemas'
            },
            {
                id: '2',
                titulo: 'Troca de peças',
                categoria: 'maquinas',
                prioridade: 'media',
                status: 'andamento',
                prazo: '2026-07-30',
                data: new Date().toISOString(),
                descricao: 'Impressora com defeito'
            }
        ];
        renderizarDemandas();
        mostrarNotificacao('Usando dados de exemplo (offline)', 'info');
    }
}

// =============================================
// RENDERIZAR DEMANDAS
// =============================================
function renderizarDemandas() {
    const tbody = document.getElementById('demandasBody');
    tbody.innerHTML = '';
    
    let demandasFiltradas = demandas;
    if (filtroCategoria) {
        demandasFiltradas = demandas.filter(d => d.categoria === filtroCategoria);
    }
    
    if (demandasFiltradas.length === 0) {
        tbody.innerHTML = `
            <tr>
                <td colspan="8" class="text-center text-muted py-4">
                    <i class="fas fa-inbox fa-2x d-block mb-2"></i>
                    ${filtroCategoria ? `Nenhuma demanda na categoria "${filtroCategoria}"` : 'Nenhuma demanda encontrada'}
                </td>
            </tr>
        `;
        return;
    }
    
    demandasFiltradas.forEach((demanda, index) => {
        const statusClass = {
            'pendente': 'badge-pendente',
            'andamento': 'badge-andamento',
            'concluido': 'badge-concluido'
        }[demanda.status] || 'badge-pendente';
        
        const prioridadeClass = demanda.prioridade === 'urgente' ? 'badge-urgente' : '';
        
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td>${index + 1}</td>
            <td><strong>${demanda.titulo}</strong></td>
            <td><span class="badge bg-info">${demanda.categoria}</span></td>
            <td><span class="badge ${prioridadeClass || 'bg-secondary'}">${demanda.prioridade}</span></td>
            <td><span class="badge-status ${statusClass}">${demanda.status}</span></td>
            <td>${demanda.prazo || 'Sem prazo'}</td>
            <td>${new Date(demanda.data).toLocaleDateString('pt-BR')}</td>
            <td>
                <button class="btn btn-sm btn-warning btn-editar" data-id="${demanda.id}">
                    <i class="fas fa-edit"></i>
                </button>
                <button class="btn btn-sm btn-danger btn-excluir" data-id="${demanda.id}">
                    <i class="fas fa-trash"></i>
                </button>
            </td>
        `;
        tbody.appendChild(tr);
    });
    
    // Eventos
    document.querySelectorAll('.btn-editar').forEach(btn => {
        btn.addEventListener('click', function() {
            const id = this.dataset.id;
            const demanda = demandas.find(d => d.id === id);
            if (demanda) abrirModalEditar(demanda);
        });
    });
    
    document.querySelectorAll('.btn-excluir').forEach(btn => {
        btn.addEventListener('click', function() {
            const id = this.dataset.id;
            if (confirm('Tem certeza que deseja excluir esta demanda?')) {
                excluirDemanda(id);
            }
        });
    });
}

// =============================================
// ADICIONAR DEMANDA
// =============================================
document.getElementById('demandaForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const btn = document.getElementById('btnSalvarDemanda');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Salvando...';
    
    const demanda = {
        setor: setorAtual,
        titulo: document.getElementById('demandaTitulo').value,
        categoria: document.getElementById('demandaCategoria').value,
        prioridade: document.getElementById('demandaPrioridade').value,
        prazo: document.getElementById('demandaPrazo').value || null,
        descricao: document.getElementById('demandaDescricao').value,
        status: 'pendente',
        data: new Date().toISOString()
    };
    
    try {
        await db.collection('demandas').add(demanda);
        mostrarNotificacao('Demanda adicionada! ✅', 'success');
        this.reset();
        await carregarDemandas();
    } catch (error) {
        console.error('Erro:', error);
        // Salvar localmente
        demanda.id = Date.now().toString();
        demandas.unshift(demanda);
        renderizarDemandas();
        mostrarNotificacao('Salvo localmente (offline)', 'info');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-save"></i> Salvar Demanda';
    }
});

// =============================================
// EDITAR DEMANDA
// =============================================
function abrirModalEditar(demanda) {
    document.getElementById('editId').value = demanda.id;
    document.getElementById('editTitulo').value = demanda.titulo;
    document.getElementById('editCategoria').value = demanda.categoria;
    document.getElementById('editPrioridade').value = demanda.prioridade;
    document.getElementById('editStatus').value = demanda.status || 'pendente';
    document.getElementById('editPrazo').value = demanda.prazo || '';
    document.getElementById('editDescricao').value = demanda.descricao || '';
    
    new bootstrap.Modal(document.getElementById('modalEditar')).show();
}

document.getElementById('btnSalvarEdicao').addEventListener('click', async function() {
    const id = document.getElementById('editId').value;
    const dadosAtualizados = {
        titulo: document.getElementById('editTitulo').value,
        categoria: document.getElementById('editCategoria').value,
        prioridade: document.getElementById('editPrioridade').value,
        status: document.getElementById('editStatus').value,
        prazo: document.getElementById('editPrazo').value || null,
        descricao: document.getElementById('editDescricao').value
    };
    
    try {
        await db.collection('demandas').doc(id).update(dadosAtualizados);
        mostrarNotificacao('Atualizado! ✅', 'success');
        bootstrap.Modal.getInstance(document.getElementById('modalEditar')).hide();
        await carregarDemandas();
        if (setorAtual === 'admin') {
            await carregarAdmin();
        }
    } catch (error) {
        console.error('Erro:', error);
        // Atualizar localmente
        const index = demandas.findIndex(d => d.id === id);
        if (index !== -1) {
            demandas[index] = { ...demandas[index], ...dadosAtualizados };
            renderizarDemandas();
        }
        bootstrap.Modal.getInstance(document.getElementById('modalEditar')).hide();
        mostrarNotificacao('Atualizado localmente', 'info');
    }
});

// =============================================
// EXCLUIR DEMANDA
// =============================================
async function excluirDemanda(id) {
    try {
        await db.collection('demandas').doc(id).delete();
        mostrarNotificacao('Excluída! 🗑️', 'success');
        await carregarDemandas();
        if (setorAtual === 'admin') {
            await carregarAdmin();
        }
    } catch (error) {
        console.error('Erro:', error);
        demandas = demandas.filter(d => d.id !== id);
        renderizarDemandas();
        mostrarNotificacao('Excluída localmente', 'info');
    }
}

// =============================================
// ADMIN
// =============================================
async function carregarAdmin() {
    if (setorAtual !== 'admin') return;
    
    try {
        const tbody = document.getElementById('adminBody');
        tbody.innerHTML = `
            <tr>
                <td colspan="9" class="text-center py-4">
                    <div class="loading-spinner"></div>
                    <p class="mt-2 text-muted">Carregando dados...</p>
                </td>
            </tr>
        `;
        
        let query = db.collection('demandas').orderBy('data', 'desc');
        
        if (filtroSetorAdmin) {
            query = query.where('setor', '==', filtroSetorAdmin);
        }
        
        const snapshot = await query.get();
        
        todasDemandas = [];
        snapshot.forEach(doc => {
            todasDemandas.push({ id: doc.id, ...doc.data() });
        });
        
        renderizarAdmin();
        atualizarStats();
    } catch (error) {
        console.error('Erro:', error);
        mostrarNotificacao('Erro ao carregar admin', 'error');
    }
}

function renderizarAdmin() {
    const tbody = document.getElementById('adminBody');
    tbody.innerHTML = '';
    
    if (todasDemandas.length === 0) {
        tbody.innerHTML = `
            <tr>
                <td colspan="9" class="text-center text-muted py-4">
                    <i class="fas fa-inbox fa-2x d-block mb-2"></i>
                    Nenhuma demanda
                </td>
            </tr>
        `;
        return;
    }
    
    todasDemandas.forEach((demanda, index) => {
        const statusClass = {
            'pendente': 'badge-pendente',
            'andamento': 'badge-andamento',
            'concluido': 'badge-concluido'
        }[demanda.status] || 'badge-pendente';
        
        const prioridadeClass = demanda.prioridade === 'urgente' ? 'badge-urgente' : '';
        
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td>${index + 1}</td>
            <td><span class="badge bg-primary">${demanda.setor}</span></td>
            <td><strong>${demanda.titulo}</strong></td>
            <td><span class="badge bg-info">${demanda.categoria}</span></td>
            <td><span class="badge ${prioridadeClass || 'bg-secondary'}">${demanda.prioridade}</span></td>
            <td><span class="badge-status ${statusClass}">${demanda.status}</span></td>
            <td>${demanda.prazo || 'Sem prazo'}</td>
            <td>${new Date(demanda.data).toLocaleDateString('pt-BR')}</td>
            <td>
                <button class="btn btn-sm btn-warning btn-editar-admin" data-id="${demanda.id}">
                    <i class="fas fa-edit"></i>
                </button>
                <button class="btn btn-sm btn-danger btn-excluir-admin" data-id="${demanda.id}">
                    <i class="fas fa-trash"></i>
                </button>
            </td>
        `;
        tbody.appendChild(tr);
    });
    
    document.querySelectorAll('.btn-editar-admin').forEach(btn => {
        btn.addEventListener('click', function() {
            const id = this.dataset.id;
            const demanda = todasDemandas.find(d => d.id === id);
            if (demanda) abrirModalEditar(demanda);
        });
    });
    
    document.querySelectorAll('.btn-excluir-admin').forEach(btn => {
        btn.addEventListener('click', function() {
            const id = this.dataset.id;
            if (confirm('Tem certeza?')) {
                excluirDemanda(id);
            }
        });
    });
}

function atualizarStats() {
    document.getElementById('totalDemandas').textContent = todasDemandas.length;
    document.getElementById('totalPendentes').textContent = 
        todasDemandas.filter(d => d.status === 'pendente' || d.status === 'andamento').length;
    document.getElementById('totalConcluidas').textContent = 
        todasDemandas.filter(d => d.status === 'concluido').length;
    document.getElementById('totalUrgentes').textContent = 
        todasDemandas.filter(d => d.prioridade === 'urgente').length;
}

// =============================================
// EXPORTAR EXCEL
// =============================================
document.getElementById('btnExportarExcel').addEventListener('click', function() {
    if (todasDemandas.length === 0) {
        mostrarNotificacao('Sem dados para exportar!', 'error');
        return;
    }
    
    const dados = todasDemandas.map(d => ({
        'Setor': d.setor,
        'Título': d.titulo,
        'Categoria': d.categoria,
        'Prioridade': d.prioridade,
        'Status': d.status,
        'Prazo': d.prazo || 'Sem prazo',
        'Data': new Date(d.data).toLocaleDateString('pt-BR'),
        'Descrição': d.descricao || ''
    }));
    
    const wb = XLSX.utils.book_new();
    const ws = XLSX.utils.json_to_sheet(dados);
    XLSX.utils.book_append_sheet(wb, ws, 'Demandas');
    XLSX.writeFile(wb, `demandas_espep_${new Date().toISOString().split('T')[0]}.xlsx`);
    mostrarNotificacao('Excel exportado! 📊', 'success');
});

// =============================================
// FILTROS
// =============================================
document.getElementById('btnFiltrarCategoria').addEventListener('click', function() {
    const categoria = prompt('Categoria (servicos, maquinas, software, infraestrutura, pessoal, outros):');
    if (categoria === null) return;
    
    if (categoria.trim() === '') {
        filtroCategoria = '';
    } else {
        filtroCategoria = categoria.toLowerCase();
    }
    renderizarDemandas();
});

document.getElementById('btnLimparFiltro').addEventListener('click', function() {
    filtroCategoria = '';
    renderizarDemandas();
});

document.getElementById('btnFiltrarSetorAdmin').addEventListener('click', function() {
    const setor = prompt('Setor (nuset, rh, financeiro, tecnologia, administracao):');
    if (setor === null) return;
    
    if (setor.trim() === '') {
        filtroSetorAdmin = '';
    } else {
        filtroSetorAdmin = setor.toLowerCase();
    }
    carregarAdmin();
});

